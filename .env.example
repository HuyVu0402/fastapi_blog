SECRET_KEY=replace-with-a-random-secret

# Local SQLite (default). For PostgreSQL use the psycopg driver below.
DATABASE_URL=sqlite+aiosqlite:///./blog.db
# DATABASE_URL=postgresql+psycopg://blog_user:password@localhost:5432/blog

# Password reset email: configure your SMTP provider before sending email.
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true
FRONTEND_URL=http://localhost:8000
