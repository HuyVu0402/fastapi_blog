SECRET_KEY=replace-with-a-random-secret

# Local SQLite (default). For PostgreSQL use the psycopg driver below.
DATABASE_URL=sqlite+aiosqlite:///./blog.db
# DATABASE_URL=postgresql+psycopg://blog_user:password@localhost:5432/blog

# Optional S3. Omit S3_BUCKET_NAME to keep local image storage.
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=us-east-1
# Prefer an IAM role or the standard AWS credential chain in production.
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# S3_PUBLIC_URL=https://your-public-bucket-or-cdn-base-url

# Password reset email: configure your SMTP provider before sending email.
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true
FRONTEND_URL=http://localhost:8000
